    GROUPBOX        "题目与答题",IDC_GROUP_RIGHT,233,28,280,365
    EDITTEXT        IDC_STATIC_QUESTION,243,42,260,162,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | NOT WS_TABSTOP
    LTEXT           "答题区域，请在此输入",IDC_STATIC_LABEL,243,208,120,12
