    PUSHBUTTON      "恢复已保存答案",IDC_BTN_RESTORE,353,332,100,26
    PUSHBUTTON      "VS调试运行",IDC_BTN_DEBUG,243,364,88,26
    PUSHBUTTON      "提交判题",IDC_BTN_SUBMIT,337,364,88,26
    PUSHBUTTON      "返回主界面",IDC_BTN_BACK,431,364,72,26
END

IDD_SCORE_DLG DIALOGEX 0, 0, 300, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
