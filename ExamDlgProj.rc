IDD_EXAMDLGPROJ_DIALOG DIALOGEX 0, 0, 430, 364
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "河北对口升学计算机程序设计练习系统"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "题库列表（双击题目可直接开始练习，支持难度/真题筛选，可拖动窗口右下角放大）",IDC_GROUP_LIST,7,7,416,240
    LISTBOX         IDC_LIST_QUESTION,17,22,396,204,LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "共 0 题",IDC_STATIC_COUNT,17,230,396,10
    LTEXT           "难度筛选：",IDC_LABEL_LEVEL,17,259,50,10
    CONTROL         "简单",IDC_CHK_SIMPLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,68,258,40,11
    CONTROL         "中等",IDC_CHK_MEDIUM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,110,258,40,11
    CONTROL         "困难",IDC_CHK_HARD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,152,258,40,11
    PUSHBUTTON      "全选",IDC_BTN_ALL_LEVEL,196,256,40,16
    CONTROL         "只看真题",IDC_CHK_REAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,240,258,60,11
    PUSHBUTTON      "随机抽题并开始",IDC_BTN_RANDOM,306,254,94,22
    LTEXT           "考试时长(分钟)：",IDC_LABEL_TIME,17,286,80,10
    EDITTEXT        IDC_EDIT_TIME,100,283,50,18,ES_AUTOHSCROLL
    LTEXT           "当前选中：--",IDC_STATIC_SEL,160,286,263,10
    PUSHBUTTON      "开始练习",IDC_BTN_START,7,304,416,30,BS_DEFPUSHBUTTON
    PUSHBUTTON      "查看成绩表",IDC_BTN_SCORETABLE,7,338,72,14,BS_FLAT
    PUSHBUTTON      "说明",IDC_BTN_ABOUT,300,338,40,14,BS_FLAT
    PUSHBUTTON      "给作者回血",IDC_BTN_SUPPORT,343,338,80,14,BS_FLAT
END

