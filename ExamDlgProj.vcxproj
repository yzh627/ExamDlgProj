  <!-- ===== 每次生成都把最新题库同步到输出目录 =====
       原因：程序优先读 exe 同目录的 questions.dat/questions.txt，
       如果 x64\Debug 里留着一份旧题库，改了题也看不到效果。
       这个目标每次都执行（不受"增量生成"跳过的影响）。 -->
  <Target Name="SyncQuestionBankToOutDir" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)questions.txt"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)questions.txt')" />
    <Copy SourceFiles="$(ProjectDir)questions.dat"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)questions.dat')" />
  </Target>
